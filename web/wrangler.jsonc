{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pinhole",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-21",
	"observability": { "enabled": true },
	"vars": {
		// Model calls proxied with the site's OpenRouter key (secret OPENROUTER_API_KEY).
		"ALLOWED_MODELS": "anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5,deepseek/deepseek-v4-flash,google/gemini-3.1-flash-lite",
		"DAILY_CAP_USD": "5",
		"MAX_TOKENS": "8000"
	},
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pinhole-db",
			"database_id": "607221c3-cc52-442d-86b0-4ff32ab59028",
			"migrations_dir": "migrations"
		}
	]
}
